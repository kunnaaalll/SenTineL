# Sentinel environment variables (spec section 14.2) — copy to .env and fill in
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
NEWS_API_KEY=
NEWS_API_PROVIDER=financial_modeling_prep
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional — only needed if config/adapters.yaml enables apex
APEX_ENDPOINT_URL=

# --- Phase 1 additions ---
# Runtime environment -> Pinecone namespace for dev/prod isolation (spec 8.2). Default: dev
SENTINEL_ENV=dev
# Contact address woven into the descriptive User-Agent SEC requires (spec 6.2).
# SEC fair-access policy requires a REAL contact address before live EDGAR traffic.
SEC_CONTACT_EMAIL=your-email@example.com
# Pinecone index name; ensure_index() provisions it serverless unless it already exists
PINECONE_INDEX_NAME=sentinel

# --- Phase 2 additions: LLM providers ---
# Fallback order, comma-separated. Providers whose key/package is missing are skipped.
LLM_PROVIDER_ORDER=openai,ollama
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Local Ollama fallback (optional; chat only unless an embedding model is set)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=            # leave unset to disable Ollama embeddings
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5

# --- Phase 2 additions: ingestion ---
INGEST_BATCH_SIZE=64
DELETE_BEFORE_REINGEST=true          # wipe a source_id's vectors before re-adding it
PINECONE_METADATA_CAP_BYTES=38000    # Pinecone rejects per-vector metadata over ~40KB
ENABLE_LLM_ENTITY_EXTRACTION=false   # deterministic regex extraction runs regardless

# --- Phase 2 additions: query path ---
ENABLE_LLM_QUERY_REWRITE=false       # deterministic normalization runs regardless
RAG_TOP_K=6
RAG_EXCERPT_CHARS=1600
RAG_CONTEXT_CHAR_BUDGET=9000
