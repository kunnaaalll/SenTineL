# Environment / secrets
.env
.env.*
!.env.example

# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node (Phase 5 frontend)
node_modules/
.next/

# Terraform — state files contain resolved values and must never be committed.
# .terraform/ is the plugin/cache dir; lock files (.terraform.lock.hcl) ARE committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
.terraformrc
terraform.rc

# Docker (local-only overrides)
docker-compose.override.yml
compose.override.yaml

# Logs and local databases
*.log
*.db
*.sqlite
*.sqlite3

# OS / editor / local tool state
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
